.venv/
__pycache__/
*.pyc
.pytest_cache/
pytest-cache-files-*/
.DS_Store
.map-model-test-temp/

# Keep the folder layout in Git; raw data and generated contents stay local.
/cache/**
!/cache/.gitkeep
!/cache/transit/
!/cache/input_versions/
!/cache/external_sources/
!/cache/*/.gitkeep
/output/**
!/output/.gitkeep
!/output/*/
!/output/*/.gitkeep
/input/**
!/input/.gitkeep
!/input/assets/
!/input/gis/
!/input/gis_reference/
!/input/transit/
!/input/*/.gitkeep
/reference/**
!/reference/.gitkeep
!/reference/*/
!/reference/*/.gitkeep

# Prevent accidentally committing loose copies of source/reference material.
/*.csv
/*.xlsx
/*.docx
/*.zip
